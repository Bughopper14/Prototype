# Copy to apps/backend/.env. Never commit .env; never put these values in the frontend.

# API server
API_PORT=3001
# Extra browser origins allowed to call the API with cookies (comma separated). Empty = same-origin only
# (the frontend proxies /api, so development needs nothing here).
CORS_ORIGINS=
# Reverse proxy trust for X-Forwarded-* headers: "loopback" (default), a hop count such as 1, or false
TRUST_PROXY=loopback

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Session cookie "Secure" flag: leave empty to set it only on HTTPS requests; true/false forces it
COOKIE_SECURE=

# Session policy (minutes)
SESSION_INACTIVITY_MINUTES=15
SESSION_MAX_LIFETIME_MINUTES=120

# OCR service (apps/ocr). Empty PYTHON_PATH = apps/ocr/.venv, then "python" on PATH.
PYTHON_PATH=
OCR_DIR=../ocr

# Local file storage (relative to apps/backend). Ignored for files when S3_BUCKET is set.
STORAGE_DIR=storage

# Optional private S3 / MinIO storage. Leave empty to store files on local disk.
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
