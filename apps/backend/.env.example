# Copy to apps/backend/.env. Never commit .env; never put these values in the frontend.

# API server
API_PORT=3001
# Extra browser origins allowed to call the API with cookies (comma separated). Empty = same-origin only
# (the frontend proxies /api, so development needs nothing here).
CORS_ORIGINS=
# Reverse proxy trust for X-Forwarded-* headers: "loopback" (default), a hop count such as 1, or false
TRUST_PROXY=loopback

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=
# Table prefix for User Management subsystem (default: users_)
USER_MANAGEMENT=users_
# CRM tables (crm_liugong design). CRM_PREFIX is prepended to every CRM table name (default crm_).
CRM_PREFIX=crm_

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Session cookie "Secure" flag: leave empty to set it only on HTTPS requests; true/false forces it
COOKIE_SECURE=

# Session policy (minutes)
SESSION_INACTIVITY_MINUTES=15
SESSION_MAX_LIFETIME_MINUTES=120

# OCR service (apps/ocr). Empty PYTHON_PATH = apps/ocr/.venv, then "python" on PATH.
PYTHON_PATH=
OCR_DIR=./ocr

# Local file storage (relative to apps/backend). Ignored for files when S3_BUCKET is set.
STORAGE_DIR=storage

# Optional private S3 / MinIO storage. Leave empty to store files on local disk.
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Lark (Feishu) integration for approvals: an approver can approve or reject from a Lark message as well as from the website.
# A decision made from Lark is marked LARK in crm_application_approval_decisions.decided_via (the website marks WEB).
# Not wired to code yet: these are the settings the Lark bot will read. Leave LARK_ENABLED=false until the bot is set up.
LARK_ENABLED=false
# Lark international: https://open.larksuite.com    Feishu (China): https://open.feishu.cn
LARK_BASE_URL=https://open.larksuite.com
# From the Lark developer console (your custom app > Credentials and Basic Info)
LARK_APP_ID=
LARK_APP_SECRET=
# From Events and Callbacks: used to verify that a callback really comes from Lark
LARK_VERIFICATION_TOKEN=
LARK_ENCRYPT_KEY=
# Public address of the website, used for the "open in CRM" link inside a Lark message
APP_PUBLIC_URL=
