{
  "name": "@liugong/backend",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS API: auth, sessions, MySQL, document storage and the bridge to the OCR service.",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:setup": "tsx --import ./src/config/load-env.ts scripts/db-setup.ts",
    "user:create": "tsx --import ./src/config/load-env.ts scripts/create-user.ts",
    "import:pre-analysis": "tsx --import ./src/config/load-env.ts scripts/import-pre-analysis.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@liugong/shared": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "bcryptjs": "^3.0.2",
    "compression": "^1.7.5",
    "decimal.js": "^10.4.3",
    "express": "^5.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.11.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
