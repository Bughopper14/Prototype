PORT=3001
# Database: use MySQL by setting DB_CLIENT=mysql, or set DATABASE_URL for PostgreSQL.
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lfiinternal
# Leave DATABASE_URL empty when using MySQL or the embedded PostgreSQL engine.
DATABASE_URL=
# Set both in production. Local development creates and persists a random secret.
JWT_SECRET=
BOOTSTRAP_PASSWORD=
# Optional private S3 / MinIO storage. All four credentials/settings are required.
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
