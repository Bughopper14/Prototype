PORT=3001
# Leave empty to use the persistent embedded PostgreSQL engine in .data/db
DATABASE_URL=
# Set both in production. Local development creates and persists a random secret.
JWT_SECRET=
BOOTSTRAP_PASSWORD=
# Optional private S3 / MinIO storage. All four credentials/settings are required.
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
