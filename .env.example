# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Session cookie "Secure" flag: leave empty to set it only on HTTPS requests; true/false forces it
COOKIE_SECURE=

# Session policy (minutes)
SESSION_INACTIVITY_MINUTES=15
SESSION_MAX_LIFETIME_MINUTES=120

# OCR (Python service in services/ocr). Defaults to "python" on PATH.
PYTHON_PATH=
#   (leave empty to use services/ocr/.venv, then python on PATH)

# Optional private S3 / MinIO storage. Leave empty to store files on local disk.
S3_BUCKET=
S3_REGION=ap-southeast-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
