{
  "name": "liugong-finance-los",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:setup": "pnpm --filter @liugong/backend db:setup",
    "user:create": "pnpm --filter @liugong/backend user:create",
    "import:pre-analysis": "pnpm --filter @liugong/backend import:pre-analysis"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
